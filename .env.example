# Supabase Configuration (Get these from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key for backend administrative operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API Key for AI Task Suggestions (Optional - fallback available if not provided)
OPENAI_API_KEY=your-openai-api-key-here
